# ---------- Server ----------
PORT=5000
# Frontend URL(s) allowed to call this API (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# ---------- Admin login (ONLY the client uses this) ----------
ADMIN_EMAIL=pragya@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string


SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
# Who receives booking / contact notifications
OWNER_EMAIL=pragya@example.com
# Name shown in the "From" field
MAIL_FROM_NAME=Pragya Prateek Website
# Also send the customer an automatic confirmation email? (true/false)
SEND_CUSTOMER_CONFIRMATION=true


RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
